<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 与 src/debug 同义：profile 构建（性能基线用 flutter drive 的 profile
         模式）同样需要工具链能识别启动 activity，release 不读这个目录。 -->
    <application>
        <activity
            android:name=".MainActivity"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".MainActivityBook"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivityPage"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivityArrow"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivityConverge"
            tools:node="remove" />
        <activity-alias
            android:name=".MainActivityTray"
            tools:node="remove" />
    </application>
</manifest>
